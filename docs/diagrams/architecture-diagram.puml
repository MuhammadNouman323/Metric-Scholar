@startuml ScholarMetric_Architecture
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Scholar Metric — Architecture Design Diagram

Person(admin, "Administrator", "Manages users, courses, evaluations, reports")
Person(faculty, "Faculty", "Views feedback and metrics")
Person(student, "Student", "Submits anonymous evaluations")

System_Boundary(scholar, "Scholar Metric Application") {
  Container(web, "Web UI", "Blade, Tailwind CSS v4, Vite 8", "Role-based dashboards and forms")
  Container(app, "Laravel 13 Application", "PHP 8.3+", "Controllers, Middleware, Services, Repositories")
  Container(events, "Event System", "Laravel Events/Listeners", "Evaluation lifecycle notifications")
  Container(scheduler, "Scheduler", "Artisan Commands", "evaluation:process-lifecycle (daily + per-request)")
  ContainerDb(db, "MySQL Database", "Relational DB", "Users, courses, evaluations, feedback, sessions, queues")
  Container(storage, "File Storage", "Laravel public disk", "User avatars")
}

System_Ext(gemini, "Google Gemini API", "AI content moderation for text feedback")

Rel(admin, web, "Uses", "HTTPS")
Rel(faculty, web, "Uses", "HTTPS")
Rel(student, web, "Uses", "HTTPS")
Rel(web, app, "HTTP requests", "routes/web.php")
Rel(app, db, "Reads/Writes", "Eloquent ORM")
Rel(app, storage, "Stores avatars")
Rel(app, gemini, "Moderates comments", "HTTPS REST")
Rel(scheduler, db, "Updates evaluation status")
Rel(scheduler, events, "Fires EvaluationActivated/Closed")
Rel(events, db, "Stores notifications")

@enduml
