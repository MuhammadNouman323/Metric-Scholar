@startuml ScholarMetric_Sequence_PublishEvaluation
title Sequence Diagram — Admin Publishes an Evaluation

actor Administrator as Admin
participant "AdminController" as AC
participant "EvaluationService" as ES
participant "EvaluationRepository" as ER
database "Database" as DB
participant "ProcessEvaluationsLifecycle" as CMD
participant "Notifications" as N

Admin -> AC : Complete 3-step wizard and Publish
AC -> ES : publishEvaluation(data, facultyIds, courseMapping)
ES -> DB : Check no active/scheduled evaluation exists
alt Another cycle is active
  ES --> AC : ValidationException
  AC --> Admin : Error message
else OK to publish
  ES -> ER : create(evaluation, status=scheduled)
  ER -> DB : INSERT evaluations
  ES -> ER : attachFaculty(evaluation, facultyIds)
  ER -> DB : INSERT evaluation_faculty
  ES -> ER : attachCourses(evaluation, coursePivot)
  ER -> DB : INSERT evaluation_courses
  ES -> ES : generateTokensForEvaluation()
  ES -> DB : INSERT feedback_tokens (per enrolled student)
  ES -> N : NewEvaluationScheduledNotification
  ES -> CMD : Artisan::call(evaluation:process-lifecycle)
  CMD -> DB : Activate if start_date <= today
  AC --> Admin : Redirect to evaluations list
end

@enduml
